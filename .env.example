# Copy to .env for local development — never commit .env.
# In production every one of these is set in the Netlify dashboard
# (Site settings → Environment variables), not in a file.

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_your_secret_key            # server-side only
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key   # bundled into the browser; the only VITE_ var that should exist

# --- Promo code (validated server-side; never bundled) ---
DISCOUNT_CODE=YOUR-PROMO-CODE

# --- Order emails (Nodemailer over SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=orders@example.com
SMTP_PASSWORD=your_smtp_password
ADMIN_EMAIL=orders@example.com                       # "from" address, also CC'd on every confirmation

# --- Google Sheets order log ---
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id

# URL is provided automatically by Netlify (the site's public URL) and is used
# for Stripe's success/cancel redirects — no need to set it yourself.

# --- Dev tooling (optional) ---
SOCKET_API_TOKEN=your_socket_api_token_here
